[Unit]
Description=Daily + at-login Cyan Tide accent rotation

[Timer]
# Apply the correct color shortly after the user manager starts.
OnStartupSec=45s
# Rotate at the start of each local day. Persistent catches up after sleep/offline.
OnCalendar=daily
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
